#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure --buildsystem=cmake --builddirectory=build -- -DCJOSE_BUILD_TESTS=ON

override_dh_auto_build:
	cmake --build build

override_dh_auto_test:
	ctest --test-dir build --output-on-failure

override_dh_auto_install:
	dh_auto_install --buildsystem=cmake --builddirectory=build
