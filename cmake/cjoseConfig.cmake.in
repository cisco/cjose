@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
find_dependency(OpenSSL REQUIRED COMPONENTS Crypto)
find_dependency(Jansson 2.3 REQUIRED)

include("${CMAKE_CURRENT_LIST_DIR}/cjoseTargets.cmake")

if(TARGET cjose::cjose AND NOT TARGET cjose::shared)
    add_library(cjose::shared ALIAS cjose::cjose)
endif()
